# ==========================================
# Django 核心與安全性配置 (Security & Core)
# ==========================================
# 生產環境請務必替換為由 secrets.token_urlsafe(50) 產生的強隨機字串
SECRET_KEY=django-insecure-&ylodbrn(rl81#fb*@h$vf55hbaw*!g%vf#92ffenc6rc1082(
# 生產環境嚴格設置為 False，開發環境可設置為 True
DEBUG=True
# 允許的主機名稱 (以逗號分隔)，生產環境填寫實際網域與反向代理主機名
ALLOWED_HOSTS=127.0.0.1,localhost,web

# ==========================================
# MySQL 資料庫連線配置 (Database Connection)
# ==========================================
DB_NAME=stock_tw_analyse
DB_USER=root
DB_PASSWORD=
# 本機開發直連 MySQL (當 Django 在容器內時): host.docker.internal 或 localhost
# 容器化 MySQL 服務請填寫: db
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# 容器化 MySQL 映像檔初始化參數 (僅容器化 MySQL 啟用時需要)
# ==========================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=stock_tw_analyse
MYSQL_USER=stockuser
MYSQL_PASSWORD=stockpassword

# ==========================================
# Redis 快取與 Celery 異步任務配置 (Cache & Celery)
# ==========================================
# 本機開發直連本機 Redis: redis://127.0.0.1:6379/0
# 容器化 Redis 服務請填寫: redis://redis:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ==========================================
# 外部目錄掛載路徑配置 (External Directory)
# ==========================================
# 容器化時掛載至 /app/Gemini_task，未指定時預設讀取專案上一層的 Gemini_task
GEMINI_TASK_DIR=/app/Gemini_task

# ==========================================
# 外部與本地 LLM 模型配置 (LLM Adapters)
# ==========================================
# 當 Django 在容器內時，存取 Windows 宿主機 Ollama 服務請設為 host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
GEMINI_ADVISOR_MODEL=gemini-2.5-flash

